# LLM API Configuration (any OpenAI SDK-compatible LLM API)
# Note: token consumption can be high — try simulations with fewer than 40 rounds first
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o

# ===== Zep Cloud Memory Graph Configuration =====
# Free monthly quota is sufficient for basic usage: https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== Deployment / Security =====
# Debug defaults to OFF. Only enable for local development; the Werkzeug
# debugger is remote code execution when reachable. It additionally refuses to
# run on a non-loopback host unless FLASK_ALLOW_PUBLIC_DEBUG=true.
# FLASK_DEBUG=false
#
# The backend binds to 127.0.0.1 by default. Set 0.0.0.0 only behind a firewall
# or reverse proxy, ideally together with ADMIN_API_KEY.
# FLASK_HOST=127.0.0.1
#
# Cross-origin access. The bundled frontend is same-origin (Vite proxy / same
# server) and needs nothing here. List extra origins only if another site must
# call the API from the browser (comma-separated).
# CORS_ORIGINS=https://app.example.com
#
# Mutating API calls (POST/PUT/PATCH/DELETE) must send "X-SimSend-Client: 1";
# the bundled frontend does this. Non-browser API clients must add it too.
#
# Log level for logs/mirofish.log and the console (request bodies are never logged).
# LOG_LEVEL=INFO
#
# Ports. Change these if 3000/5001 are already taken on your machine; the
# frontend dev server, its /api proxy, and docker-compose all follow them.
# FRONTEND_PORT=3000
# FLASK_PORT=5001
#
# Vite dev server bind address (default localhost) and browser auto-open.
# FRONTEND_HOST=localhost
# FRONTEND_OPEN=true
#
# docker-compose: host interface the container port is published on.
# Default 127.0.0.1; use 0.0.0.0 only behind a reverse proxy + ADMIN_API_KEY.
# BIND_ADDRESS=127.0.0.1
#
# Optional; a random per-process key is generated when unset.
# SECRET_KEY=change-me-to-a-long-random-string
#
# Optional admin key. When set, the full-power graph/simulation/report API
# requires an "X-Admin-Key: <this value>" header for all writes/deletes and the
# enumerate-everything endpoints (/list, /api/graph/tasks, /api/simulation/history).
# Single-resource reads stay open. Leave unset on a loopback-only install.
# It is also what unlocks the landing page's sign-up list (/api/signup/list),
# which stays closed while this is unset.
# ADMIN_API_KEY=change-me-to-a-long-random-string
#
# Resource limits for client-supplied parameters.
# SIMSEND_MAX_CONCURRENT_SIMULATIONS=2   # simultaneous OASIS subprocesses
# SIMSEND_MAX_SIMULATION_ROUNDS=1000     # upper bound for max_rounds
# SIMSEND_MAX_PARALLEL_PROFILES=20       # upper bound for parallel_profile_count
# SIMSEND_MAX_SIGNUPS=10000              # landing-page sign-ups kept before new ones are refused
# SIMSEND_SIGNUP_RATE_LIMIT=20           # sign-ups per client IP per 10 minutes
# MIROFISH_MAX_JOBS=8                    # background job pool size

# ===== Boost LLM Configuration (Optional) =====
# If not using a separate boost LLM, remove these lines entirely from your .env
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here

# ===== Swarm LLM Configuration (Optional) =====
# Dedicated model lane for the OASIS audience-simulation agents only.
# Profile generation, simulation-config generation, and the report agent
# keep using LLM_* above. Each var falls back to its LLM_* counterpart
# when unset, so leaving this block commented out preserves the default.
#
# Example: route the swarm to a local Gemma model served by Ollama.
# SWARM_LLM_API_KEY=ollama
# SWARM_LLM_BASE_URL=http://localhost:11434/v1
# SWARM_LLM_MODEL_NAME=gemma4:2b
#
# How much of its own history each simulated persona sends with every call, in
# tokens. Older turns are dropped first; the persona profile is always kept.
# Without a cap, prompts grow every round and long simulations get expensive.
# 0 turns the cap off.
# SWARM_CONTEXT_TOKEN_LIMIT=12000
